# ── Firebase (скопируйте в .env.local) ─────────────────────
# Firebase Console → Project settings → Your apps → Web app → firebaseConfig
# Также: Build → Firestore Database → создать БД (test mode для разработки)
# Правила: firebase deploy --only firestore:rules

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Локальный эмулятор (опционально): firebase emulators:start --only firestore
# VITE_USE_EMULATOR=true

# PIN для входа роли «Принимающая семья» (виден в клиентском бандле — базовая защита)
VITE_FAMILY_PIN=
