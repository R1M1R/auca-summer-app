rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamily() {
      return isSignedIn() && (request.auth.token.role == 'family' || request.auth.token.role == 'host');
    }

    function isStudent() {
      return isSignedIn() && request.auth.token.role == 'student';
    }

    function protectedCategory(cat) {
      return cat in ['academic', 'excursion', 'mandatory', 'family'];
    }

    function eventStartInFuture(data) {
      return data.date > request.time;
    }

    function studentOwns(data) {
      return isStudent() && data.createdBy == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if true;

      /* Host / admin: full schedule management */
      allow create: if isFamily()
        || (isSignedIn() && request.auth.token.role == 'admin');

      allow update, delete: if isFamily()
        || (isSignedIn() && request.auth.token.role == 'admin');

      /* Student: create only personal future plans */
      allow create: if isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.category == 'student_personal'
        && request.resource.data.isEditable == true
        && eventStartInFuture(request.resource.data);

      /* Student: update/delete only own editable future non-protected events */
      allow update: if isStudent()
        && studentOwns(resource.data)
        && studentOwns(request.resource.data)
        && !protectedCategory(resource.data.category)
        && !protectedCategory(request.resource.data.category)
        && resource.data.isEditable == true
        && eventStartInFuture(resource.data);

      allow delete: if isStudent()
        && studentOwns(resource.data)
        && !protectedCategory(resource.data.category)
        && resource.data.isEditable == true
        && eventStartInFuture(resource.data);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /diary_entries/{entryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
