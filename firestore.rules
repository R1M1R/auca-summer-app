rules_version = '2';

// PROTOTYPE — приложение пока без Firebase Auth.
// Перед публикацией замените на правила с аутентификацией (см. firebase-firestore-standard skill).

service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /diary_entries/{entryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
